{
  "githubUsers": ["zachleat"],
  "githubOrgs": ["11ty"],
  "npmMaintainers": ["zachleat"],

  "monitor": [],
  "exclude": [],
  "alwaysInclude": [
    "zachleat/glyphhanger",
    "zachleat/resizeasaurus",
    "zachleat/flex-luthor",
    "zachleat/f2em.com",
    "zachleat/github-issue-to-json-file",
    "zachleat/zachleat.com",
    "zachleat/web-font-loading-recipes",
    "zachleat/educational-sensational-inspirational-foundational",
    "zachleat/font-family-reunion",
    "zachleat/Humane-Dates",
    "zachleat/queue-code",
    "zachleat/selecthor",
    "zachleat/ALARMd",
    "zachleat/rainglow",
    "zachleat/foitfout",
    "zachleat/uniclode",
    "zachleat/unicode-range-interchange",

    "11ty/gray-matter",
    "11ty/nunjucks",
    "11ty/recursive-copy",
    "11ty/docs",
    "11ty/11ty-community",
    "11ty/11ty-conf",
    "11ty/demo-webc-counter",
    "11ty/api-screenshot",
    "11ty/api-indieweb-avatar",
    "11ty/api-opengraph-image",
    "11ty/api-sparkline",
    "11ty/api-built-with",
    "11ty/api-explorer"
  ],
  "alwaysIncludePackages": [
    "@awesome.me/buildawesome",
    "@11ty/client"
  ],

  "options": {
    "publishedOnly": true,
    "includeReposWithoutPackageJson": false,
    "downloadsPeriod": "last-year",
    "cacheDuration": "15m",
    "outputDir": "docs",
    "concurrency": 8
  },

  "scoring": {
    "backlogWeights": {
      "openIssues": 0.3,
      "openPRs": 0.7
    },
    "backlogFloor": 0,
    "fullyStaleDays": 730,
    "issuesSaturation": 300,
    "prsSaturation": 60,
    "vulnerabilitiesSaturation": 10,
    "securityWeight": 0.5,
    "importanceWeights": {
      "downloads": 0.85,
      "stars": 0.15
    },
    "downloadsSaturation": 1000000,
    "starsSaturation": 5000,
    "importanceFloor": 0.3
  }
}
