{
  "githubUsers": ["zachleat"],
  "githubOrgs": ["11ty"],
  "npmMaintainers": ["zachleat"],

  "monitor": [],
  "exclude": [],
  "alwaysInclude": [
    "zachleat/glyphhanger",
    "zachleat/resizeasaurus",
    "zachleat/flex-luthor",
    "zachleat/github-issue-to-json-file",
    "11ty/gray-matter",
    "11ty/nunjucks",
    "11ty/recursive-copy",
    "zachleat/zachleat.com",
    "11ty/docs",
    "11ty/11ty-community",
    "zachleat/web-font-loading-recipes",
    "zachleat/educational-sensational-inspirational-foundational"
  ],
  "alwaysIncludePackages": [
    "@awesome.me/buildawesome",
    "@11ty/client"
  ],

  "options": {
    "publishedOnly": true,
    "includeReposWithoutPackageJson": false,
    "downloadsPeriod": "last-year",
    "cacheDuration": "15m",
    "outputDir": "docs",
    "concurrency": 8
  },

  "scoring": {
    "backlogWeights": {
      "openIssues": 0.3,
      "openPRs": 0.7
    },
    "backlogFloor": 0.05,
    "fullyStaleDays": 730,
    "issuesSaturation": 300,
    "prsSaturation": 60,
    "importanceWeights": {
      "downloads": 0.85,
      "stars": 0.15
    },
    "downloadsSaturation": 1000000,
    "starsSaturation": 5000,
    "importanceFloor": 0.3
  }
}
